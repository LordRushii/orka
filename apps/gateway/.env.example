# Orka gateway configuration.
#
# Copy to `apps/gateway/.env` and fill in. `.env` is gitignored; never commit
# real keys, and never paste one into the extension -- the browser only ever
# holds the gateway session token below.

# Shared secret between the extension and this gateway. Any non-empty string.
# Required when NODE_ENV=production; defaults to "orka-dev-token" otherwise.
ORKA_GATEWAY_TOKEN=orka-dev-token

# Which provider profiles this gateway will serve. Comma-separated.
# Defaults to "mock,lmstudio" -- the two that need no credentials. A provider
# that is not listed here cannot be selected by any request.
ORKA_ENABLED_PROVIDERS=mock,lmstudio

# Abort budget for a single provider call, in ms (1000-120000). Default 30000.
ORKA_PLAN_TIMEOUT_MS=30000

# --- LM Studio (local) ------------------------------------------------------
# Must stay on loopback; the adapter refuses any other host at startup.
ORKA_LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
ORKA_LMSTUDIO_MODEL=qwen3-vl-4b-instruct

# --- Cloud providers (opt-in) ----------------------------------------------
# Setting a key only configures the profile; the provider must also appear in
# ORKA_ENABLED_PROVIDERS before a request can select it.

# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_MODEL=deepseek-v4-flash-vision-exp

# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
# ANTHROPIC_MODEL=claude-sonnet-4-5

# All three are required together for the openai-compatible profile.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o
